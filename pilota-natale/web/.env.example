# Sviluppo locale: copia in web/.env.development.local
# (letto solo da `vite dev`, mai dalla build di produzione).
VITE_USE_EMULATORS=true

# URL pubblico usato nei QR dei negozi. Se assente usa l'indirizzo da cui apri l'admin
# (in locale: http://IP-DEL-PC:5173, così il QR funziona con gli emulatori).
# VITE_PUBLIC_BASE_URL=https://fiscal-pilota-natale.web.app
