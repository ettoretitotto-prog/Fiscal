# Configurazione delle Cloud Functions (caricata al deploy e negli emulatori).
# Mittente delle email. Finché il tuo dominio non è verificato su Resend lascia
# onboarding@resend.dev: consegna solo all'email del proprietario dell'account Resend.
MAIL_FROM="Fiscal <regali@resofiscal.it>"
# Indirizzo a cui arrivano le risposte (facoltativo)
MAIL_REPLY_TO=ettoretitotto@icloud.com
# URL pubblico del sito usato nei link delle email (vuoto = https://<id-progetto>.web.app)
PUBLIC_BASE_URL=https://resofiscal.it
