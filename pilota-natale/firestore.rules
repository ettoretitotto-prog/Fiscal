rules_version = '2';

// Fiscal – Pilota Natale
//
// Principio: i client leggono/scrivono solo il minimo indispensabile.
// Prove, codici, consensi, invii ed eventi (passi 2-6) sono gestiti
// esclusivamente lato server (Cloud Functions con Admin SDK, che ignora
// queste regole): per i client restano chiusi grazie al "deny" finale.
//
// Ruoli: documento users/{uid} = { role: 'admin' | 'shop', shopId? }.
// Lo scrive solo un admin (o lo script scripts/set-admin.mjs).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function hasProfile() {
      return signedIn() && exists(userDoc());
    }
    function isAdmin() {
      return hasProfile() && get(userDoc()).data.role == 'admin';
    }
    function isShopOf(shopId) {
      return hasProfile()
        && get(userDoc()).data.role == 'shop'
        && get(userDoc()).data.shopId == shopId;
    }
    function isText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // ---------- Profili / ruoli ----------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'shopId', 'email', 'createdAt'])
        && request.resource.data.role in ['admin', 'shop']
        && (request.resource.data.role == 'admin'
            || (request.resource.data.shopId is string
                && existsAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId))));
      allow delete: if isAdmin();
    }

    // ---------- Negozi (informazioni pubbliche) ----------
    // Leggibili da chiunque con l'ID (servono alla pagina /n/{shopId} e /r/{token}).
    // L'elenco completo è riservato all'admin.
    function validShop(d) {
      return d.keys().hasOnly(['name', 'address', 'exchangeRules', 'discountText',
                               'active', 'createdAt', 'updatedAt'])
        && isText(d.name, 1, 80)
        && isText(d.address, 0, 160)
        && isText(d.exchangeRules, 0, 600)
        && isText(d.discountText, 0, 300)
        && d.active is bool;
    }

    match /shops/{shopId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && shopId.matches('^[a-z0-9][a-z0-9-]{2,39}$')
        && validShop(request.resource.data);
      allow update: if validShop(request.resource.data) && (
        isAdmin()
        || (isShopOf(shopId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['exchangeRules', 'discountText', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // ---------- Dati riservati del negozio (solo admin) ----------
    match /shopAccounts/{shopId} {
      allow read, write: if isAdmin();
    }

    // Tutto il resto è chiuso ai client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
